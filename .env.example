POSTGRES_USER=retailops
POSTGRES_DB=retailops
# Generate this value with scripts/init-env.ps1. Do not use this file as credentials.
POSTGRES_PASSWORD=
# Production uses an independently generated restricted-runtime password.
APP_DB_PASSWORD=
# The initialization script writes the matching host connection strings to .env.
# Host development uses PostgreSQL on 127.0.0.1:5450.
# Production additionally requires RETAILOPS_DOMAIN and CADDY_EMAIL.
